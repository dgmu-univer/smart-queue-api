<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="001.create_users_table-1" author="senior_dev">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="users"/>
      </not>
    </preConditions>

    <createSequence sequenceName="user_id_seq" startValue="1" incrementBy="1"/>

    <createTable tableName="users">
      <column name="id" type="BIGINT" defaultValueComputed="nextval('user_id_seq')">
        <constraints primaryKey="true" primaryKeyName="pk_users_id" nullable="false"/>
      </column>
      <column name="username" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uq_users_username"/>
      </column>
      <column name="first_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="middle_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="last_name" type="VARCHAR(255)"/>
      <column name="password" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="email" type="VARCHAR(255)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uq_users_email"/>
      </column>
      <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="role" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <comment>Initial creation of users table for security</comment>
  </changeSet>

  <changeSet id="001.create_users_table-2" author="senior_dev">

    <preConditions onFail="MARK_RAN">
      <tableIsEmpty tableName="users"/>
    </preConditions>


