<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="002.create_admin_settings_table-1" author="senior_dev">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="admin_settings"/>
      </not>
    </preConditions>

    <createSequence sequenceName="admin_setting_id_seq" startValue="1" incrementBy="1"/>

    <createTable tableName="admin_settings">
      <column name="id" type="BIGINT" defaultValueComputed="nextval('admin_setting_id_seq')">
        <constraints primaryKey="true" primaryKeyName="pk_admin_settings"/>
      </column>
      <column name="slot_duration_minutes" type="INT" defaultValueNumeric="15">
        <constraints nullable="false"/>
      </column>
      <column name="slot_capacity_per_slot" type="INT" defaultValueNumeric="1">
        <constraints nullable="false"/>
      </column>
      <column name="work_start_date" type="DATE">
        <constraints nullable="false"/>
      </column>
      <column name="work_end_date" type="DATE">
        <constraints nullable="false"/>
      </column>
      <column name="work_start_time" type="TIME">
        <constraints nullable="false"/>
      </column>
      <column name="work_end_time" type="TIME">
        <constraints nullable="false"/>
      </column>
      <column name="lunch_start_time" type="TIME"/>
      <column name="lunch_end_time" type="TIME"/>
    </createTable>

    <createTable tableName="non_working_days">
      <column name="setting_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="non_working_date" type="DATE">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey tableName="non_working_days"
      columnNames="setting_id, non_working_date"
      constraintName="pk_non_working_days"/>

    <addForeignKeyConstraint baseTableName="non_working_days"
      baseColumnNames="setting_id"
      referencedTableName="admin_settings"
      referencedColumnNames="id"
      constraintName="fk_settings_days"
      onDelete="CASCADE"/>

    <createTable tableName="excluded_slots">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" primaryKeyName="pk_admin_settings_excluded_slots"/>
      </column>
      <column name="setting_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="slot_date" type="DATE">
        <constraints nullable="false"/>
      </column>
      <column name="start_time" type="TIME">
        <constraints nullable="false"/>
      </column>
      <column name="end_time" type="TIME">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint baseTableName="excluded_slots"
      baseColumnNames="setting_id"
      referencedTableName="admin_settings"
      referencedColumnNames="id"
      constraintName="fk_settings_excluded_slots"
      onDelete="CASCADE"/>

    <comment>Initial creation of admin settings</comment>
  </changeSet>

  <changeSet id="002.create_admin_settings_table-2" author="senior_dev">
    <preConditions onFail="MARK_RAN">
      <tableIsEmpty tableName="admin_settings"/>
    </preConditions>
  </changeSet>

</databaseChangeLog>
